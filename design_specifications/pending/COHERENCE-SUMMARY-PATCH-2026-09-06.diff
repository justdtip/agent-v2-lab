+def test_an_unknown_tool_is_recovered_by_any_later_successful_call_within_the_window() -> None:
+    steps = [
+        _step(1, "open_file", {"file": "a"}, "ERROR: invalid call: unknown tool: open_file; available tools are read_file"),
