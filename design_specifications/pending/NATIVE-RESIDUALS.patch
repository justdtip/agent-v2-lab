diff --git a/tests/test_lens_regression.py b/tests/test_lens_regression.py
index e589661..934583d 100644
--- a/tests/test_lens_regression.py
+++ b/tests/test_lens_regression.py
@@ -178,3 +178,64 @@ def test_held_targets_select_alpha_instead_of_fit_error():
         direct = np.eye(2) * (10 / (1 + row["alpha"]))
         expected = np.sum((np.eye(2) - direct) ** 2)
